# ==============================================================================
# NEONFORGE OS: PRODUCTION ENVIRONMENT CONFIGURATION SPECIFICATION
# ==============================================================================
# Copy this file to .env and configure real credentials prior to live launch.
# NOTE: Never commit live secret keys to version control.
# ==============================================================================

# 1. CORE APPLICATION RUNTIME
PORT=3000
NODE_ENV=development # Set to "production" when deploying live
APP_URL=https://www.neonforgedigital.net

# 2. MANDATORY PRODUCTION ADMINISTRATIVE AUTHENTICATION
# Required when NODE_ENV=production. The server will reject startup if missing.
ADMIN_PASSWORD=your_secure_strong_production_admin_password
ADMIN_API_KEY=your_secure_random_production_admin_api_key
SERVER_PAYMENT_HMAC_SECRET=your_32_byte_hex_hmac_secret_for_payment_tokens

# 3. STRIPE PAYMENT ENGINE (Live / Test Gateway)
# Obtain from: https://dashboard.stripe.com/apikeys
# Live mode requires keys starting with sk_live_ / pk_live_
# Test mode uses keys starting with sk_test_ / pk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_51...
STRIPE_SECRET_KEY=sk_test_51...
# Obtain webhook secret from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# 4. ETSY OPEN API v3 INTEGRATION
# Register app at: https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_etsy_v3_keystring
ETSY_SHARED_SECRET=your_etsy_v3_shared_secret
ETSY_SHOP_ID=your_numeric_etsy_shop_id
ETSY_SHOP_NAME=your_official_etsy_shop_name
ETSY_ACCESS_TOKEN=your_oauth_bearer_access_token

# 5. SQUARE INTEGRATION (Apple Pay / Cash App / Card Checkout)
# Obtain from: https://developer.squareup.com/apps
SQUARE_APPLICATION_ID=sq0idp-...
SQUARE_ACCESS_TOKEN=EAAA...
SQUARE_LOCATION_ID=L...
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_signature_key

# 6. GOOGLE GEMINI AI ENGINE (Optional - Catalog Synthesis)
# Automatically injected in AI Studio. When self-hosting, obtain from Google AI Studio.
GEMINI_API_KEY=
